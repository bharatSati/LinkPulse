# Server
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/linkpulse

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Analytics (salt used to hash visitor IPs; falls back to JWT_SECRET when unset)
IP_HASH_SALT=

# Deployment URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# AI integration (reserved for a later prompt)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
