# Server
PORT=5000
# Console verbosity: error | warn | info | debug. Default keeps startup and real
# errors only; set LOG_LEVEL=debug to also see per-request and background logs.
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/linkpulse

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Analytics (salt used to hash visitor IPs; falls back to JWT_SECRET when unset)
IP_HASH_SALT=

# Deployment URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# CSV bulk import limits
IMPORT_MAX_FILE_MB=2
IMPORT_MAX_ROWS=1000

# AI integration (Groq)
# The AI insights features require a valid Groq API key. Without it, the API
# still returns rule-based anomaly detection but no AI-generated text.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=20000
# Bounded retries against the same model when a transient failure occurs
# (rate/token limits, timeouts, connection drops, 5xx). Total attempts includes
# the first try and is capped at 5; the delay grows with GROQ_RETRY_BASE_MS up to
# GROQ_RETRY_MAX_MS between attempts, so we never send unlimited requests.
GROQ_MAX_ATTEMPTS=3
GROQ_RETRY_BASE_MS=600
GROQ_RETRY_MAX_MS=4000
# Minutes a generated insight is reused before regeneration. The frontend can
# force a refresh with ?refresh=true.
AI_INSIGHTS_TTL_MINUTES=30
# Days that generated insights are retained for GET /ai/history.
AI_HISTORY_DAYS=60
# Maximum accepted length of a natural-language question.
AI_QUESTION_MAX_LENGTH=300

# Workspace invitations
# Days an invitation token remains valid before it expires.
INVITATION_TTL_DAYS=7
# Transactional email delivery over SMTP (Nodemailer).
# Email sending is considered configured only when BOTH SMTP_HOST and MAIL_FROM
# are set. Until then, invitations are still created but the invite link is
# returned in the API response for manual sharing (development flow) instead of
# being emailed. Local testing: run Mailpit (smtp on 1025) and set SMTP_HOST=localhost.
# Example (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>.
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS on port 465, false for STARTTLS on 587/2525.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional reply-to address for invitation emails.
MAIL_REPLY_TO=

# Abuse detection, notifications, and security retention
# How long security events / notifications are retained (TTL indexes).
SECURITY_EVENT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=180
# Automated link disabling is OFF by default. Traffic volume or an unfamiliar
# domain NEVER disables a link; enforcement is a human decision unless this is
# explicitly enabled together with a high-confidence destination rule.
ABUSE_AUTO_DISABLE=false
# Minimum minutes between repeat alerts for the same link/source.
ABUSE_ALERT_COOLDOWN_MINUTES=15
# Link creation burst: max links per workspace per rolling window.
ABUSE_LINK_CREATION_MAX=20
ABUSE_LINK_CREATION_WINDOW_MINUTES=10
# Per-source short-link request burst (keyed by hashed visitor IP).
ABUSE_SOURCE_REQUEST_MAX=150
ABUSE_SOURCE_REQUEST_WINDOW_SECONDS=60
# Click spikes: must exceed both the multiplier over baseline and the minimum.
ABUSE_CLICK_SPIKE_MULTIPLIER=8
ABUSE_CLICK_SPIKE_MIN_CLICKS=30
ABUSE_CLICK_SPIKE_WINDOW_MINUTES=10
ABUSE_CLICK_SPIKE_CHECK_MS=60000
# Repeated failed password attempts against protected links.
ABUSE_PASSWORD_FAIL_MAX=10
ABUSE_PASSWORD_FAIL_WINDOW_MINUTES=15
# Destination risk score at/above which a link is flagged for review.
ABUSE_DESTINATION_RISK_SCORE=50
# Minutes a visitor may not file duplicate reports for the same link.
ABUSE_REPORT_THROTTLE_MINUTES=60
